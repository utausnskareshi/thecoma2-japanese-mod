<Project>

  <!-- 全プロジェクト共通の設定。厳密な型付けと警告のエラー化で、曖昧なコードを早期に検出する。 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- バージョンと表示用の情報（配布Zipのファイル名にも使う） -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>歌うＬＩＮＥ彼氏</Authors>
    <Copyright>Copyright (c) 2026 歌うＬＩＮＥ彼氏</Copyright>
    <Product>The Coma 2: Vicious Sisters 日本語化パッチ（非公式）</Product>
    <NeutralLanguage>ja-JP</NeutralLanguage>
  </PropertyGroup>

</Project>
